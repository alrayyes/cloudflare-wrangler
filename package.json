{
	"name": "cloudflare-wrangler-docker-image",
	"private": true,
	"description": "Docker image with cloudflare wrangler installed",
	"version": "1.2.1",
	"author": "Ryan Kes <511318+alrayyes@users.noreply.github.com>",
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@commitlint/cli": "21.2.2",
		"@commitlint/config-conventional": "21.2.2",
		"@fission-ai/openspec": "1.11.0",
		"lefthook": "2.1.12",
		"markdownlint-cli2": "0.23.2",
		"prettier": "3.9.6",
		"wrangler": "4.127.1"
	},
	"scripts": {
		"lint": "biome check",
		"lint:fix": "biome migrate --write && biome check --write",
		"format": "prettier --write .",
		"lint:format": "prettier --check .",
		"lint:md": "markdownlint-cli2",
		"lint:grammar": "sh scripts/ltex.sh",
		"prose:sync": "bun run scripts/install-vale.ts && .tools/vale sync",
		"lint:prose": ".tools/vale --glob='!{styles/**,CHANGELOG.md,.claude/**,openspec/**}' --minAlertLevel=error .",
		"lint:prose:advice": ".tools/vale --glob='!{styles/**,CHANGELOG.md,.claude/**,openspec/**}' .",
		"prepare": "test -n \"$CI\" || lefthook install"
	},
	"repository": "https://github.com/alrayyes/cloudflare-wrangler",
	"bugs": {
		"url": "https://github.com/alrayyes/cloudflare-wrangler/issues"
	},
	"license": "GPL-3.0-or-later"
}
